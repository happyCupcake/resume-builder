// Modify your form submit handler
resumeForm.addEventListener('submit', async (e) => {
    e.preventDefault();
    
    if (!window.userId) {
        alert('Please login first');
        return;
    }

    try {
        const jobDescription = document.getElementById('jobDescription').value;
        const resume = document.getElementById('resume').value;

        if (!jobDescription.trim() || !resume.trim()) {
            alert('Please provide both job description and resume');
            return;
        }

        const submitButton = e.target.querySelector('button');
        submitButton.disabled = true;

        const response = await fetch('/analyze', {
            method: 'POST',
            headers: {
                'Content-Type': 'application/json',
            },
            body: JSON.stringify({ 
                jobDescription, 
                resume,
                userId: window.userId
            })
        });

        const data = await response.json();
        
        if (data.success) {
            sessionStorage.setItem('currentAnalysisId', data.analysisId);
            
            // Show results
            const resultDiv = document.getElementById('result');
            resultDiv.style.display = 'block';
            
            // Update preview content
            document.getElementById('fieldResult').innerHTML = `
                <p><strong>Detected Field:</strong> ${data.field}</p>
            `;
            
            document.getElementById('previewPoints').innerHTML = `
                <li>Field: ${data.field}</li>
                <li>Keyword Match Score: ${data.score}%</li>
                <li>Top Keywords Found:
                    <ul>
                        ${data.matchingWords.map(keyword => `<li>${keyword}</li>`).join('')}
                    </ul>
                </li>
                <li>Areas for Improvement Available</li>
            `;

            // Reset payment section
            PaymentSection.reset();
            
            console.log('Analysis complete, payment section reset');
        } else {
            alert('Analysis failed. Please try again.');
        }
    } catch (error) {
        console.error('Error:', error);
        alert('An error occurred during analysis');
    } finally {
        e.target.querySelector('button').disabled = false;
    }
});




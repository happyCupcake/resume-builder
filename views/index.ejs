                                        </div>
                                        <div style="width: 70%; padding: 20px;">
                                            <div style="margin-bottom: 25px;">
                                                ${sections.length > 1 ? sections[1] : ''}
                                            </div>
                                            <div>
                                                ${sections.length > 2 ? 
                                                  sections.slice(2)
                                                    .filter(s => s && !s.toLowerCase().includes('skills'))
                                                    .join('<div style="margin-top: 20px;"></div>') 
                                                  : ''}
                                            </div>

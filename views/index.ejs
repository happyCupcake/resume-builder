const PaymentSection = {
    init() {
        this.section = document.querySelector('.payment-section');
        this.initializeBuyButton();
    },

    initializeBuyButton() {
        // Clear existing content
        this.section.innerHTML = `
            <button id="buyButton" class="payment-button">
                Unlock Full Results ($5)
            </button>
        `;
        
        const buyButton = document.getElementById('buyButton');
        buyButton.style.display = 'block';
        
        // Attach event listener
        buyButton.addEventListener('click', this.handleBuyButtonClick.bind(this));
        
        console.log('Buy button initialized:', {
            element: buyButton,
            display: buyButton.style.display,
            visibility: window.getComputedStyle(buyButton).visibility,
            parentDisplay: window.getComputedStyle(this.section).display
        });
    },

    async handleBuyButtonClick(event) {
        const button = event.target;
        if (!window.userId) {
            alert('Please login first');
            return;
        }

        try {
            button.disabled = true;
            button.textContent = 'Processing...';

            const analysisId = sessionStorage.getItem('currentAnalysisId');
            console.log('Creating payment intent for analysis:', analysisId);

            const response = await fetch('/create-payment-intent', {
                method: 'POST',
                headers: {
                    'Content-Type': 'application/json',
                },
                body: JSON.stringify({
                    userId: window.userId,
                    analysisId: analysisId
                })
            });

            const { clientSecret } = await response.json();
            await this.showPaymentForm(clientSecret);
            
        } catch (error) {
            console.error('Payment Error:', error);
            alert('Payment failed: ' + error.message);
            this.resetBuyButton(button);
        }
    },

    async showPaymentForm(clientSecret) {
        const appearance = {
            theme: 'stripe',
            variables: {
                colorPrimary: '#5469d4',
            }
        };

        // Create Stripe elements
        const elements = stripe.elements({ appearance, clientSecret });
        const paymentElement = elements.create('payment');

        // Setup payment form
        this.section.innerHTML = `
            <div id="payment-form"></div>
            <button class="payment-button" id="payNowButton" style="margin-top: 20px;">
                Pay Now
            </button>
        `;

        // Mount payment element
        paymentElement.mount('#payment-form');

        // Setup pay now button
        const payNowButton = document.getElementById('payNowButton');
        payNowButton.addEventListener('click', async (e) => {
            e.preventDefault();
            payNowButton.disabled = true;
            payNowButton.textContent = 'Processing...';

            const { error } = await stripe.confirmPayment({
                elements,
                confirmParams: {
                    return_url: `${window.location.origin}/payment-complete`,
                }
            });

            if (error) {
                payNowButton.disabled = false;
                payNowButton.textContent = 'Pay Now';
                alert(error.message);
                // Reset to buy button if payment fails
                this.initializeBuyButton();
            }
        });
    },

    resetBuyButton(button) {
        button.disabled = false;
        button.textContent = 'Unlock Full Results ($5)';
    },

    // Call this after successful analysis
    reset() {
        this.initializeBuyButton();
        this.section.style.display = 'block';
    }
};


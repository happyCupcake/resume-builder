                    function applyTemplate(templateName, content) {
                        const resumeDiv = document.getElementById('optimizedResume');
                        
                        // Parse resume content into sections safely
                        const sections = content.split('\n\n').filter(s => s && s.trim());
                        
                        // Default, safe handling
                        if (templateName === 'classic' || sections.length === 0) {
                            resumeDiv.innerHTML = content.replace(/\n\n/g, '<br><br>').replace(/\n/g, '<br>');
                            resumeDiv.style.whiteSpace = 'pre-wrap';
                            return;

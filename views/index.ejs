        const payNowButton = document.createElement('button');
        payNowButton.textContent = 'Pay Now';
        payNowButton.className = 'payment-button';
        payNowButton.style.marginTop = '20px';
        document.querySelector('.payment-section').appendChild(payNowButton);

        // Handle payment submission
        payNowButton.addEventListener('click', async (e) => {
            e.preventDefault();
            payNowButton.disabled = true;
            payNowButton.textContent = 'Processing...';

            const { error } = await stripe.confirmPayment({
                elements,
                confirmParams: {
                    return_url: `${window.location.origin}/payment-complete`,
                }
            });

            if (error) {
                payNowButton.disabled = false;
                payNowButton.textContent = 'Pay Now';
                alert(error.message);
            }
        });

    } catch (error) {
        console.error('Payment Error:', error);
        alert('Payment failed: ' + error.message);
    } finally {
        buyButton.disabled = false;
        buyButton.textContent = 'Unlock Full Results ($5)';
    }
});

    </script>
</body>
</html>
<body>
    <div class="page-container">
        <!-- Navigation -->
        <nav class="navbar">
            <div class="navbar-inner">
                <div class="logo">
                    <i class="fas fa-rocket"></i> Resume Rocket
                </div>
                <div id="userStatus">
                    <span id="userName"></span>
                    <button id="loginBtn" class="auth-button" style="display: none;">
                        <i class="fab fa-google"></i> Sign in with Google
                    </button>
                    <button id="logoutBtn" class="auth-button" style="display: none;">
                        <i class="fas fa-sign-out-alt"></i> Logout
                    </button>
                </div>
            </div>
        </nav>
        
        <!-- Main Content -->
        <div class="main-content">
            <!-- Hero Section -->
            <div class="hero">
                <h1>Land Your Dream Job with AI-Optimized Resumes</h1>
                <p>Our AI-powered tool analyzes job descriptions and tailors your resume to increase interview chances by up to 70%</p>
            </div>
            
            <!-- How It Works -->
            <div class="steps">
                <div class="step">
                    <i class="fas fa-file-alt"></i>
                    <h3>Step 1</h3>
                    <p>Paste the job description and your current resume</p>
                </div>
                <div class="step">
                    <i class="fas fa-robot"></i>
                    <h3>Step 2</h3>
                    <p>Our AI analyzes your resume against the job requirements</p>
                </div>
                <div class="step">
                    <i class="fas fa-check-circle"></i>
                    <h3>Step 3</h3>
                    <p>Get your optimized resume tailored for the specific position</p>
                </div>
            </div>
            
            <!-- Form Section -->
            <div class="container form-section">
                <form id="resumeForm">
                    <div class="form-group">
                        <label for="jobDescription">
                            <i class="fas fa-briefcase"></i> Job Description
                        </label>
                        <textarea id="jobDescription" name="jobDescription" 
                            placeholder="Copy and paste the job description here..."></textarea>
                    </div>
                    
                    <div class="form-group">
                        <label for="resume">
                            <i class="fas fa-file-alt"></i> Your Current Resume
                        </label>
                        <textarea id="resume" name="resume" 
                            placeholder="Copy and paste your current resume here..."></textarea>
                    </div>

                    <button type="submit">
                        <i class="fas fa-magic"></i> Analyze and Optimize
                    </button>
                </form>

                <!-- Results Section -->
                <div id="result">
                    <div class="result-header">
                        <i class="fas fa-chart-bar"></i>
                        <h2>Analysis Results</h2>
                    </div>
                    
                    <div id="previewSection">
                        <!-- Field Detection -->
                        <div class="score-card">
                            <div id="fieldResult"></div>
                            
                            <!-- Score Meter -->
                            <div>
                                <h3>Keyword Match Score</h3>
                                <div class="score-meter">
                                    <div class="score-fill" id="scoreFill" style="width: 0%"></div>
                                </div>
                                <p id="scoreText"></p>
                            </div>
                            
                            <!-- Keywords -->
                            <div>
                                <h3>Top Matching Keywords</h3>
                                <div class="keyword-pills" id="keywordList"></div>
                            </div>
                        </div>
                        
                        <!-- Preview Section -->
                        <div class="preview-card">
                            <h3>Preview of Optimizations</h3>
                            <ul id="previewPoints"></ul>
                            <p class="preview-notice">Unlock the fully optimized resume tailored to this specific job description.</p>
                        </div>
                        
                        <!-- Payment Section -->
                        <div class="payment-section">
                            <button id="buyButton" class="payment-button">
                                <i class="fas fa-unlock-alt"></i> Unlock Full Results ($0.50)
                            </button>
                        </div>
                    </div>

                    <!-- Full Results (After Payment) -->
                    <div id="fullResults">
                        <div class="result-section-title">
                            <i class="fas fa-file-alt"></i>
                            <h3>Your Optimized Resume</h3>
                        </div>
                        <div id="optimizedResume"></div>
                        <div class="action-buttons" id="resultButtons">
                            <!-- Buttons will be added via JavaScript -->
                        </div>
                    </div>
                </div>
            </div>
            
            <!-- Testimonials -->
            <div class="testimonials">
                <h2 class="testimonial-title">What Our Users Say</h2>
                <div class="testimonial-grid">
                    <div class="testimonial-card">
                        <div class="testimonial-content">
                            <p>After updating my resume with Resume Rocket, I started getting interview calls within days. I landed a job at a top tech company!</p>
                        </div>
                        <div class="testimonial-author">
                            <div class="author-image">JS</div>
                            <div class="author-info">
                                <h4>Jennifer S.</h4>
                                <p class="author-job">Software Engineer</p>
                            </div>
                        </div>
                    </div>
                    <div class="testimonial-card">
                        <div class="testimonial-content">
                            <p>I was applying for months with no responses. After one optimization, I got 3 interviews in a week. The AI really knows what recruiters are looking for!</p>
                        </div>
                        <div class="testimonial-author">
                            <div class="author-image">MT</div>
                            <div class="author-info">
                                <h4>Michael T.</h4>
                                <p class="author-job">Marketing Specialist</p>
                            </div>
                        </div>
                    </div>
                    <div class="testimonial-card">
                        <div class="testimonial-content">
                            <p>As a career changer, I was struggling to highlight my transferable skills. Resume Rocket helped me create a resume that got me noticed in a new industry.</p>
                        </div>
                        <div class="testimonial-author">
                            <div class="author-image">AL</div>
                            <div class="author-info">
                                <h4>Aisha L.</h4>
                                <p class="author-job">Financial Analyst</p>
                            </div>
                        </div>
                    </div>
                </div>
            </div>
            
            <!-- Features -->
            <div class="features">
                <h2 class="features-title">Why Choose Resume Rocket</h2>
                <div class="features-grid">
                    <div class="feature-card">
                        <div class="feature-icon">
                            <i class="fas fa-brain"></i>
                        </div>
                        <h3>Advanced AI Analysis</h3>
                        <p>Our AI analyzes job descriptions to identify key skills and requirements that matter most to employers.</p>
                    </div>
                    <div class="feature-card">
                        <div class="feature-icon">
                            <i class="fas fa-tachometer-alt"></i>
                        </div>
                        <h3>Instant Results</h3>
                        <p>Get your optimized resume in seconds, not days. Apply to jobs faster and increase your chances.</p>
                    </div>
                    <div class="feature-card">
                        <div class="feature-icon">
                            <i class="fas fa-lock"></i>
                        </div>
                        <h3>Privacy Focused</h3>
                        <p>Your resume data is encrypted and never shared with third parties. We take your privacy seriously.</p>
                    </div>
                </div>
            </div>
        </div>
        
        <!-- Footer -->
        <footer class="footer">
            <div class="footer-content">
                <div class="footer-about">
                    <div class="footer-logo">
                        <i class="fas fa-rocket"></i> Resume Rocket
                    </div>
                    <p>AI-powered resume optimization to help you land your dream job.</p>
                </div>
                <div class="footer-links">
                    <h3>Quick Links</h3>
                    <ul>
                        <li><a href="#">Home</a></li>
                        <li><a href="#">How It Works</a></li>
                        <li><a href="#">Pricing</a></li>
                        <li><a href="#">Contact</a></li>
                    </ul>
                </div>
                <div class="footer-links">
                    <h3>Legal</h3>
                    <ul>
                        <li><a href="#">Privacy Policy</a></li>
                        <li><a href="#">Terms of Service</a></li>
                    </ul>
                </div>
            </div>
            <div class="footer-bottom">
                <p>&copy; 2025 Resume Rocket. All Rights Reserved.</p>
            </div>
        </footer>
    </div>

    <script>
        // Firebase Configuration
        const firebaseConfig = {
            apiKey: "AIzaSyDD_Z9FfF8N-MugynTww8ftxjxDDnSQKu4",
            authDomain: "resume-builder-a61af.firebaseapp.com",
            projectId: "resume-builder-a61af",
            storageBucket: "resume-builder-a61af.firebasestorage.app",
            messagingSenderId: "451166726638",
            appId: "1:451166726638:web:9330dbe1009f42c25946ff"
        };
        
        // Initialize Firebase
        firebase.initializeApp(firebaseConfig);

        // Initialize Stripe
        const stripe = Stripe('pk_live_51Qbz0xA4w79MCEbrRbVLfO3p712GKFY3uvtt2nJ98Z2kW7MVGTu7ZKNypD9j1e4mOt0uKeaP0yY0q8gZl6TqqIf500qKPbABs1');

        // Global variables for DOM elements
        const loginBtn = document.getElementById('loginBtn');
        const logoutBtn = document.getElementById('logoutBtn');
        const userName = document.getElementById('userName');
        const resumeForm = document.getElementById('resumeForm');

        // Analysis and Payment Management
        const AnalysisManager = {
            init() {
                this.resultDiv = document.getElementById('result');
                this.previewSection = document.getElementById('previewSection');
                this.paymentSection = document.querySelector('.payment-section');
                this.fullResults = document.getElementById('fullResults');
                
                this.initializePaymentSection();
                
                if (resumeForm) {
                    resumeForm.addEventListener('submit', this.handleSubmit.bind(this));
                }
            },

            initializePaymentSection() {
                if (!this.paymentSection) return;
                
                this.paymentSection.innerHTML = `
                    <button id="buyButton" class="payment-button">
                        Unlock Full Results ($5)
                    </button>
                `;
                
                const buyButton = document.getElementById('buyButton');
                if (buyButton) {
                    buyButton.style.display = 'block';
                    buyButton.addEventListener('click', this.handleBuyClick.bind(this));
                }
            },

            async handleSubmit(e) {
                e.preventDefault();
                
                if (!window.userId) {
                    alert('Please login first');
                    return;
                }

                const form = e.target;
                const submitButton = form.querySelector('button');
                const jobDescription = document.getElementById('jobDescription').value.trim();
                const resume = document.getElementById('resume').value.trim();

                if (!jobDescription || !resume) {
                    alert('Please provide both job description and resume');
                    return;
                }

                try {
                    submitButton.disabled = true;
                    
                    const response = await fetch('/analyze', {
                        method: 'POST',
                        headers: { 'Content-Type': 'application/json' },
                        body: JSON.stringify({ 
                            jobDescription, 
                            resume,
                            userId: window.userId
                        })
                    });

                    const data = await response.json();
                    
                    if (data.success) {
                        sessionStorage.setItem('currentAnalysisId', data.analysisId);
                        
                        this.resultDiv.style.display = 'block';
                        this.previewSection.style.display = 'block';
                        this.fullResults.style.display = 'none';
                        
                        this.updatePreview(data);
                        
                        this.initializePaymentSection();
                        this.paymentSection.style.display = 'block';
                        
                        console.log('Analysis complete, payment section reset:', {
                            paymentSection: this.paymentSection,
                            buyButton: document.getElementById('buyButton'),
                            buyButtonDisplay: document.getElementById('buyButton')?.style.display
                        });
                    } else {
                        alert(data.error || 'Analysis failed. Please try again.');
                    }
                } catch (error) {
                    console.error('Error:', error);
                    alert('An error occurred during analysis');
                } finally {
                    submitButton.disabled = false;
                }
            },

            updatePreview(data) {
                // Update field detection
                document.getElementById('fieldResult').innerHTML = `
                    <h3><i class="fas fa-briefcase"></i> Industry Detection</h3>
                    <p>Your resume is best suited for <strong>${data.field}</strong> positions</p>
                `;
                
                // Update score meter
                const scoreFill = document.getElementById('scoreFill');
                const scoreText = document.getElementById('scoreText');
                scoreFill.style.width = `${data.score}%`;
                scoreText.textContent = `Your resume matches ${data.score}% of keywords in this job description`;
                
                // Update keywords list
                const keywordList = document.getElementById('keywordList');
                keywordList.innerHTML = data.matchingWords.map(keyword => 
                    `<div class="keyword-pill"><i class="fas fa-check-circle"></i> ${keyword}</div>`
                ).join('');
                
                // Update preview points
                document.getElementById('previewPoints').innerHTML = `
                    <li>Reorganized resume structure to highlight relevant ${data.field} experience</li>
                    <li>Enhanced key skills section with industry-specific terminology</li>
                    <li>Optimized achievement statements to showcase quantifiable results</li>
                    <li>Added missing keywords to improve ATS compatibility</li>
                    <li>Strengthened professional summary to grab recruiter attention</li>
                `;
            },

            async handleBuyClick(e) {
                const button = e.target;
                if (!window.userId) {
                    alert('Please login first');
                    return;
                }

                try {
                    button.disabled = true;
                    button.textContent = 'Processing...';

                    const analysisId = sessionStorage.getItem('currentAnalysisId');
                    console.log('Creating payment intent for analysis:', analysisId);

                    const response = await fetch('/create-payment-intent', {
                        method: 'POST',
                        headers: { 'Content-Type': 'application/json' },
                        body: JSON.stringify({
                            userId: window.userId,
                            analysisId: analysisId
                        })
                    });

                    const { clientSecret } = await response.json();
                    await this.showPaymentForm(clientSecret);
                    
                } catch (error) {
                    console.error('Payment Error:', error);
                    alert('Payment failed: ' + error.message);
                    this.resetBuyButton(button);
                }
            },

            async showPaymentForm(clientSecret) {
                const appearance = {
                    theme: 'stripe',
                    variables: { 
                        colorPrimary: '#4361ee',
                        colorBackground: '#ffffff',
                        colorText: '#212529',
                        colorDanger: '#f72585',
                        fontFamily: 'Inter, system-ui, sans-serif',
                        borderRadius: '8px',
                        spacingUnit: '4px'
                    }
                };

                const elements = stripe.elements({ appearance, clientSecret });
                const paymentElement = elements.create('payment');

                this.paymentSection.innerHTML = `
                    <div class="preview-card" style="margin-bottom: 20px; background-color: rgba(76, 201, 240, 0.1); border-left: 4px solid var(--success);">
                        <h3><i class="fas fa-lock"></i> Secure Checkout</h3>
                        <p>You're just one step away from your optimized resume!</p>
                        <p style="margin-top: 10px;">
                            <i class="fas fa-shield-alt"></i> Your payment is secure and encrypted.
                        </p>
                    </div>
                    <div id="payment-form" style="padding: 20px; border-radius: 10px; box-shadow: 0 5px 15px rgba(0,0,0,0.05);"></div>
                    <button class="payment-button" id="payNowButton" style="margin-top: 20px;">
                        <i class="fas fa-credit-card"></i> Pay $0.50
                    </button>
                    <p style="margin-top: 15px; font-size: 0.9rem; color: #666; text-align: center;">
                        <i class="fas fa-info-circle"></i> You'll only be charged once, no subscription.
                    </p>
                `;

                paymentElement.mount('#payment-form');

                const payNowButton = document.getElementById('payNowButton');
                payNowButton.addEventListener('click', async (e) => {
                    e.preventDefault();
                    payNowButton.disabled = true;
                    payNowButton.innerHTML = '<i class="fas fa-spinner fa-spin"></i> Processing...';

                    const { error } = await stripe.confirmPayment({
                        elements,
                        confirmParams: {
                            return_url: `${window.location.origin}/payment-complete`,
                        }
                    });

                    if (error) {
                        payNowButton.disabled = false;
                        payNowButton.innerHTML = '<i class="fas fa-credit-card"></i> Pay $0.50';
                        
                        // Show error in a nicer way
                        const errorDiv = document.createElement('div');
                        errorDiv.className = 'preview-card';
                        errorDiv.style.marginTop = '15px';
                        errorDiv.style.backgroundColor = 'rgba(247, 37, 133, 0.1)';
                        errorDiv.style.borderLeft = '4px solid var(--danger)';
                        errorDiv.innerHTML = `
                            <h3><i class="fas fa-exclamation-circle" style="color: var(--danger);"></i> Payment Error</h3>
                            <p>${error.message}</p>
                        `;
                        this.paymentSection.appendChild(errorDiv);
                    }
                });
            },

            resetBuyButton(button) {
                button.disabled = false;
                button.innerHTML = '<i class="fas fa-unlock-alt"></i> Unlock Full Results ($0.50)';
            }
        };

        // Helper function to fetch paid results
        async function fetchPaidResults(analysisId) {
            try {
                const response = await fetch('/get-full-results', {
                    method: 'POST',
                    headers: {
                        'Content-Type': 'application/json',
                    },
                    body: JSON.stringify({ analysisId })
                });

                const data = await response.json();
                if (data.success) {
                    // Show full results
                    const fullResultsDiv = document.getElementById('fullResults');
                    fullResultsDiv.style.display = 'block';
                    
                    // Update resume content
                    const optimizedResumeDiv = document.getElementById('optimizedResume');
                    optimizedResumeDiv.innerHTML = data.optimizedResume;
                    optimizedResumeDiv.style.whiteSpace = 'pre-wrap';
                    
                    // Hide preview section
                    document.getElementById('previewSection').style.display = 'none';
                    
                    // Add action buttons
                    const buttonContainer = document.getElementById('resultButtons');
                    buttonContainer.innerHTML = '';
                    
                    // Copy button
                    const copyBtn = document.createElement('button');
                    copyBtn.innerHTML = '<i class="fas fa-copy"></i> Copy to Clipboard';
                    copyBtn.className = 'payment-button';
                    buttonContainer.appendChild(copyBtn);

                    copyBtn.addEventListener('click', () => {
                        navigator.clipboard.writeText(data.optimizedResume)
                            .then(() => {
                                copyBtn.innerHTML = '<i class="fas fa-check"></i> Copied!';
                                setTimeout(() => {
                                    copyBtn.innerHTML = '<i class="fas fa-copy"></i> Copy to Clipboard';
                                }, 2000);
                            });
                    });

                    // Download as TXT button
                    const downloadBtn = document.createElement('button');
                    downloadBtn.innerHTML = '<i class="fas fa-download"></i> Download as TXT';
                    downloadBtn.className = 'payment-button';
                    buttonContainer.appendChild(downloadBtn);
                    
                    downloadBtn.addEventListener('click', () => {
                        const blob = new Blob([data.optimizedResume], { type: 'text/plain' });
                        const url = URL.createObjectURL(blob);
                        const a = document.createElement('a');
                        a.href = url;
                        a.download = 'optimized-resume.txt';
                        document.body.appendChild(a);
                        a.click();
                        document.body.removeChild(a);
                        URL.revokeObjectURL(url);
                    });

                    // New analysis button
                    const newAnalysisBtn = document.createElement('button');
                    newAnalysisBtn.innerHTML = '<i class="fas fa-redo"></i> Start New Analysis';
                    newAnalysisBtn.className = 'payment-button';
                    buttonContainer.appendChild(newAnalysisBtn);

                    newAnalysisBtn.addEventListener('click', () => {
                        document.getElementById('resumeForm').style.display = 'block';
                        document.getElementById('result').style.display = 'none';
                        document.getElementById('fullResults').style.display = 'none';
                        document.getElementById('jobDescription').value = '';
                        document.getElementById('resume').value = '';
                        window.history.replaceState({}, '', '/');
                    });

                    // Show success message
                    const successMessage = document.createElement('div');
                    successMessage.className = 'preview-card';
                    successMessage.style.marginTop = '20px';
                    successMessage.style.backgroundColor = 'rgba(76, 201, 240, 0.1)';
                    successMessage.style.borderLeft = '4px solid var(--success)';
                    successMessage.innerHTML = `
                        <h3><i class="fas fa-check-circle" style="color: var(--success);"></i> Success!</h3>
                        <p>Your resume has been optimized for this specific job. Apply with confidence!</p>
                        <p style="margin-top: 10px;">Need more help? We offer <a href="#" style="color: var(--primary);">resume review services</a> from industry experts.</p>
                    `;
                    fullResultsDiv.appendChild(successMessage);

                    sessionStorage.removeItem('currentAnalysisId');
                }
            } catch (error) {
                console.error('Error fetching results:', error);
                alert('Error retrieving your results. Please contact support.');
            }
        }

        // Auth state observer
        firebase.auth().onAuthStateChanged((user) => {
            const urlParams = new URLSearchParams(window.location.search);
            const isPaymentSuccess = urlParams.get('redirect_status') === 'succeeded';

            if (user) {
                console.log('User details:', user.uid, user.email);

                // User is signed in
                loginBtn.style.display = 'none';
                logoutBtn.style.display = 'inline-block';
                userName.textContent = `Welcome, ${user.displayName}!`;

                // Insert user into database
                fetch('/upsert-user', {
                    method: 'POST',
                    headers: {
                        'Content-Type': 'application/json',
                    },
                    body: JSON.stringify({
                        userId: user.uid,
                        email: user.email
                    })
                })
                .then(response => response.json())
                .then(result => {
                    console.log('Upsert response:', result);
                })
                .catch(error => {
                    console.error('Error upserting user:', error);
                });
                
                if (!isPaymentSuccess) {
                    resumeForm.style.display = 'block';
                    document.getElementById('result').style.display = 'none';
                    document.getElementById('fullResults').style.display = 'none';
                }
                window.userId = user.uid;
            } else {
                // User is signed out
                loginBtn.style.display = 'inline-block';
                logoutBtn.style.display = 'none';
                userName.textContent = '';
                resumeForm.style.display = 'none';
                window.userId = null;
                
                // Hide results on logout
                document.getElementById('result').style.display = 'none';
                document.getElementById('fullResults').style.display = 'none';
                window.history.replaceState({}, '', '/');
                sessionStorage.removeItem('currentAnalysisId');
            }
        });

        // Sign in with Google
        loginBtn.addEventListener('click', () => {
            const provider = new firebase.auth.GoogleAuthProvider();
            firebase.auth().signInWithPopup(provider);
        });

        // Sign out
        logoutBtn.addEventListener('click', () => {
            firebase.auth().signOut();
        });

        // Initialize on page load
        document.addEventListener('DOMContentLoaded', () => {
            AnalysisManager.init();

            // Check for payment success redirect
            const urlParams = new URLSearchParams(window.location.search);
            const redirectStatus = urlParams.get('redirect_status');
            const analysisId = sessionStorage.getItem('currentAnalysisId');

            if (redirectStatus === 'succeeded' && analysisId) {
                document.getElementById('resumeForm').style.display = 'none';
                document.getElementById('result').style.display = 'block';
                
                // Update payment status and fetch results
                fetch('/update-payment-status', {
                    method: 'POST',
                    headers: { 'Content-Type': 'application/json' },
                    body: JSON.stringify({
                        analysisId: analysisId,
                        paymentId: urlParams.get('payment_intent')
                    })
                })
                .then(response => response.ok && fetchPaidResults(analysisId))
                .catch(error => console.error('Error in payment completion:', error));
            }
        });
    </script>
</body>
</html>
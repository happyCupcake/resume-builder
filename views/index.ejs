        window.addEventListener('DOMContentLoaded', async () => {
    const urlParams = new URLSearchParams(window.location.search);
    const redirectStatus = urlParams.get('redirect_status');
    const analysisId = sessionStorage.getItem('currentAnalysisId');

    console.log('DOMContentLoaded check:', { redirectStatus, analysisId });

    if (redirectStatus === 'succeeded' && analysisId) {
        console.log('Payment success detected');
        // Hide form and show results container
        document.getElementById('resumeForm').style.display = 'none';
        document.getElementById('result').style.display = 'block';
        
        console.log('Payment section state before update:', {
            exists: !!document.querySelector('.payment-section'),
            html: document.querySelector('.payment-section')?.innerHTML
        });

        // First update payment status
        try {
            const paymentUpdateResponse = await fetch('/update-payment-status', {
                method: 'POST',
                headers: {
                    'Content-Type': 'application/json',
                },
                body: JSON.stringify({
                    analysisId: analysisId,
                    paymentId: urlParams.get('payment_intent')
                })
            });

            if (paymentUpdateResponse.ok) {
                console.log('Payment status updated successfully');
                // Only fetch results once after payment is updated
                fetchPaidResults(analysisId);
            } else {
                console.error('Failed to update payment status');
            }
        } catch (error) {
            console.error('Error updating payment status:', error);
        }

        // Log final state
        console.log('Payment section final state:', {
            exists: !!document.querySelector('.payment-section'),
            html: document.querySelector('.payment-section')?.innerHTML
        });
    }
});

async function fetchPaidResults(analysisId) {
    try {
        const response = await fetch('/get-full-results', {
            method: 'POST',
            headers: {
                'Content-Type': 'application/json',
            },
            body: JSON.stringify({ analysisId })
        });

        const data = await response.json();
        if (data.success) {
            const fullResultsDiv = document.getElementById('fullResults');
            fullResultsDiv.style.display = 'block';
            const optimizedResumeDiv = document.getElementById('optimizedResume');
            optimizedResumeDiv.innerHTML = data.optimizedResume;
            optimizedResumeDiv.style.whiteSpace = 'pre-wrap';
            
            // Hide preview and payment sections
            document.getElementById('previewSection').style.display = 'none';
            document.querySelector('.payment-section').style.display = 'none';

            // Create button container
            const buttonContainer = document.createElement('div');
            buttonContainer.style.marginTop = '20px';
            buttonContainer.style.display = 'flex';
            buttonContainer.style.gap = '10px';
            document.getElementById('fullResults').appendChild(buttonContainer);
            
            // Add Copy to Clipboard button
            const copyBtn = document.createElement('button');
            copyBtn.textContent = 'Copy to Clipboard';
            copyBtn.className = 'payment-button';
            buttonContainer.appendChild(copyBtn);

            copyBtn.addEventListener('click', () => {
                navigator.clipboard.writeText(data.optimizedResume)
                    .then(() => {
                        copyBtn.textContent = 'Copied!';
                        setTimeout(() => {
                            copyBtn.textContent = 'Copy to Clipboard';
                        }, 2000);
                    });
            });

            // Add Start New Analysis button
            const newAnalysisBtn = document.createElement('button');
            newAnalysisBtn.textContent = 'Start New Analysis';
            newAnalysisBtn.className = 'payment-button';
            buttonContainer.appendChild(newAnalysisBtn);

            newAnalysisBtn.addEventListener('click', () => {
                // Show form and clear previous inputs
                document.getElementById('resumeForm').style.display = 'block';
                document.getElementById('result').style.display = 'none';
                document.getElementById('fullResults').style.display = 'none';
                document.getElementById('jobDescription').value = '';
                document.getElementById('resume').value = '';
                // Remove success parameter from URL
                window.history.replaceState({}, '', '/');
            });

            // Clear stored analysis ID
            sessionStorage.removeItem('currentAnalysisId');
        }
    } catch (error) {
        console.error('Error fetching results:', error);
        alert('Error retrieving your results. Please contact support.');
    }
}


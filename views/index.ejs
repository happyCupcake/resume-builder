                                            if (!section) return '';
                                            const secLines = section.split('\n');
                                            const secHeader = secLines[0] || '';
                                            const secContent = secLines.length > 1 ? secLines.slice(1).join('<br>') : '';
                                            
                                            return `<div style="margin-bottom: 25px;">
                                                <h2 style="font-size: 20px; color: var(--primary-dark); font-family: 'Poppins', sans-serif; margin-bottom: 10px; 
                                                    text-transform: uppercase; letter-spacing: 1px;">
                                                    ${secHeader}
                                                </h2>
                                                <div style="border-left: 3px solid var(--primary); padding-left: 15px;">
                                                    ${secContent}
                                                </div>
                                            </div>`;
                                        }).join('');
                                    }
                                    
                                    resumeDiv.innerHTML = `
                                    <div style="font-family: 'Inter', sans-serif;">
                                        <div style="background-color: var(--dark); color: white; padding: 20px; text-align: center;">
                                            <h1 style="font-family: 'Poppins', sans-serif; font-size: 28px; margin-bottom: 10px;">

                        const firstLines = firstSection.split('\n');
                        const headerText = firstLines[0] || (templateName === 'executive' ? 'Executive Resume' : 'Resume');
                        const contactInfo = firstLines.length > 1 ? firstLines.slice(1) : [];
                        
                        // Skills section
                        const skillsSection = sections.find(s => s && s.toLowerCase().includes('skills')) || '';
                        
                        try {
                            switch(templateName) {

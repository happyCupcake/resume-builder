# cat /etc/nginx/sites-available/resume-builder
# Add this configuration
server {
    server_name resumebuilder.store www.resumebuilder.store;

    location / {
        proxy_pass http://localhost:3000;
        proxy_http_version 1.1;
        proxy_set_header Upgrade $http_upgrade;
        proxy_set_header Connection 'upgrade';
        proxy_set_header Host $host;
        proxy_cache_bypass $http_upgrade;
        limit_req zone=one burst=3 nodelay;
        limit_conn addr 5;
    }

    listen 443 ssl; # managed by Certbot
    ssl_certificate /etc/letsencrypt/live/resumebuilder.store/fullchain.pem; # managed by Certbot
    ssl_certificate_key /etc/letsencrypt/live/resumebuilder.store/privkey.pem; # managed by Certbot
    include /etc/letsencrypt/options-ssl-nginx.conf; # managed by Certbot
    ssl_dhparam /etc/letsencrypt/ssl-dhparams.pem; # managed by Certbot


}

server {
    if ($host = www.resumebuilder.store) {
        return 301 https://$host$request_uri;
    } # managed by Certbot


    if ($host = resumebuilder.store) {
        return 301 https://$host$request_uri;
    } # managed by Certbot


    listen 80;
    server_name resumebuilder.store www.resumebuilder.store;
    return 404; # managed by Certbot




}